# NARI Root .gitignore

# ==========================================
# Frontend (React Native / Expo)
# ==========================================
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/build/
frontend/web-build/
frontend/expo-env.d.ts
frontend/ios/Pods/
frontend/android/.gradle/
frontend/android/build/
frontend/.kotlin/
frontend/*.jks
frontend/*.p8
frontend/*.p12
frontend/*.key
frontend/*.mobileprovision

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
__pycache__/
*.pyc
*.pyo
backend/venv/
backend/env/
backend/.pytest_cache/
backend/build/
backend/dist/
backend/logs/
backend/assn_lstm/
backend/assn_lstm/**
backend/assn_tcn/
backend/assn_tcn/**

# ==========================================
# Firmware (ESP32)
# ==========================================
firmware/.pio/
firmware/.vscode/
firmware/build/
firmware/*.bin
firmware/*.elf
firmware/*.map
firmware/nari_firmware/secrets.h

# ==========================================
# Secrets and Environment Variables
# ==========================================
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Service accounts & credentials
service-account-key.json
*-firebase-adminsdk-*.json
credentials.json
*.key
*.pem

# ==========================================
# General / OS
# ==========================================
.DS_Store
Thumbs.db
*.log
*.orig.*
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
.venv/
venv/
payload.json

# ==========================================
# Model weights and checkpoints
# ==========================================
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.bin
*.onnx
*.pb
*.safetensors
*.npz
*.pkl
*.joblib

