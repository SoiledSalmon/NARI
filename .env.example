# ┌─────────────────────────────────────────────┐
# │  NARI — Unified Environment Variables        │
# │  Copy this file to .env and fill in values   │
# └─────────────────────────────────────────────┘

# ==========================================
# Frontend Configuration (React Native/Expo)
# ==========================================
# Get these from Firebase Console → Project Settings → General → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# URL of the NARI FastAPI backend (include port, no trailing slash)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# API Secret Key — shared between frontend & backend for request authentication
# Generate: openssl rand -hex 32
EXPO_PUBLIC_API_SECRET_KEY=your-api-secret-key-here

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
# Path to the Firebase Service Account JSON key file (for admin SDK)
FIREBASE_CREDENTIALS_PATH=./service-account-key.json

# Matches EXPO_PUBLIC_API_SECRET_KEY
API_SECRET_KEY=your-api-secret-key-here
