rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───
    // Only the authenticated owner can read/write their own profile.
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Alerts subcollection — read-only for the user.
      // Writes come exclusively from the backend (Admin SDK bypasses rules).
      match /alerts/{alertId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Contacts subcollection — full CRUD for the owner.
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Journeys subcollection — read-only for the user.
      // Writes come from the backend via Admin SDK.
      match /journeys/{journeyId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ─── Incidents ───
    // Community-wide collection. Any authenticated user can read.
    // Only the backend (Admin SDK) can write.
    match /incidents/{incidentId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
